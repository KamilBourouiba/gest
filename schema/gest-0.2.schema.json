{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gest.dev/schema/gest-0.2.json",
  "title": ".gest IR v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "fps", "space", "channels", "timeline"],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^0\\.2(\\.\\d+)?$"
    },
    "profile": {
      "type": "string",
      "enum": ["full", "rt", "cmp", "neural", "neural_bundle"],
      "default": "full"
    },
    "fps": { "type": "number", "exclusiveMinimum": 0 },
    "time_base": {
      "type": "string",
      "enum": ["seconds", "ticks"],
      "default": "seconds"
    },
    "units": { "type": "string", "default": "meters" },
    "coordinate_system": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "handedness": { "type": "string", "enum": ["right", "left"] },
        "up": { "type": "string" },
        "forward": { "type": "string" }
      }
    },
    "capabilities": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "interpolation_defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "translation": { "type": "string" },
        "rotation": { "type": "string" },
        "scalar": { "type": "string" }
      }
    },
    "space": {
      "type": "object",
      "additionalProperties": false,
      "required": ["anchors"],
      "properties": {
        "anchors": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/anchor"
          },
          "minProperties": 1
        },
        "named_points": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/named_point"
          }
        }
      }
    },
    "channels": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/channel"
      }
    },
    "blobs": {
      "type": "object",
      "description": "Optional id -> encoded payload table (base64 or out-of-band path per implementation).",
      "additionalProperties": {
        "type": "object",
        "required": ["format"],
        "additionalProperties": false,
        "properties": {
          "format": {
            "type": "string",
            "enum": ["packed_float16", "raw_float32", "raw_uint8", "base64"]
          },
          "data": { "type": "string", "description": "Base64 when format=base64" }
        }
      }
    },
    "timeline": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/frame" }
    },
    "stream": { "$ref": "#/$defs/stream" },
    "producer_notes": {
      "type": "object",
      "description": "Off the SGPU execution path.",
      "additionalProperties": true
    }
  },
  "$defs": {
    "vec3": {
      "type": "array",
      "items": { "type": "number" },
      "minItems": 3,
      "maxItems": 3
    },
    "quat_xyzw": {
      "type": "array",
      "items": { "type": "number" },
      "minItems": 4,
      "maxItems": 4
    },
    "anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["t", "q"],
      "properties": {
        "parent": { "type": "string" },
        "t": { "$ref": "#/$defs/vec3" },
        "q": { "$ref": "#/$defs/quat_xyzw" }
      }
    },
    "named_point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parent", "local"],
      "properties": {
        "parent": { "type": "string" },
        "local": { "$ref": "#/$defs/vec3" }
      }
    },
    "channel": {
      "oneOf": [
        { "$ref": "#/$defs/channel_articulated" },
        { "$ref": "#/$defs/channel_blendshape" },
        { "$ref": "#/$defs/channel_direction" },
        { "$ref": "#/$defs/channel_scalar" },
        { "$ref": "#/$defs/channel_latent" }
      ]
    },
    "channel_articulated": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "parent", "joint_count", "joint_layout"],
      "properties": {
        "type": { "const": "articulated" },
        "parent": { "type": "string" },
        "joint_count": { "type": "integer", "minimum": 1 },
        "joint_layout": { "type": "string" },
        "state_enum": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Closed state labels; not natural-language semantics."
        },
        "joint_value_stride": {
          "type": "integer",
          "enum": [3, 7],
          "default": 3,
          "description": "Floats per joint in values: 3 (tx,ty,tz) or 7 (+ xyzw quaternion)."
        }
      }
    },
    "channel_blendshape": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "parent", "blendshape_names_sha256"],
      "properties": {
        "type": { "const": "blendshape_set" },
        "parent": { "type": "string" },
        "blendshape_names_sha256": { "type": "string", "minLength": 64, "maxLength": 64 }
      }
    },
    "channel_direction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "parent", "representation"],
      "properties": {
        "type": { "const": "direction" },
        "parent": { "type": "string" },
        "representation": { "const": "unit_vector" }
      }
    },
    "channel_scalar": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "parent"],
      "properties": {
        "type": { "const": "scalar" },
        "parent": { "type": "string" }
      }
    },
    "channel_latent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "parent", "dtype", "shape"],
      "properties": {
        "type": { "const": "latent" },
        "parent": { "type": "string" },
        "dtype": { "type": "string", "enum": ["float16", "float32", "int8", "uint8"] },
        "shape": {
          "type": "array",
          "items": { "type": "integer", "minimum": 1 },
          "minItems": 1
        },
        "decoder_hint": {
          "type": "string",
          "description": "Opaque non-semantic decoder identifier; not natural-language meaning."
        }
      }
    },
    "joint_pose": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "format": {
          "type": "string",
          "enum": ["packed_float16", "raw_float32"]
        },
        "blob_ref": true,
        "values": {
          "type": "array",
          "items": { "type": "number" },
          "description": "Optional inline joint floats when small"
        }
      }
    },
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["t", "pose"],
      "properties": {
        "t": { "type": "number", "minimum": 0 },
        "pose": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "interpolation_override": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "in_tangent": { "type": "object", "additionalProperties": true },
        "out_tangent": { "type": "object", "additionalProperties": true }
      }
    },
    "stream": {
      "type": "object",
      "additionalProperties": false,
      "required": ["segment_duration", "segments"],
      "properties": {
        "segment_duration": { "type": "number", "exclusiveMinimum": 0 },
        "segments": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["seq", "channels_digest", "byte_range"],
            "properties": {
              "seq": { "type": "integer", "minimum": 0 },
              "channels_digest": { "type": "string" },
              "byte_range": {
                "type": "array",
                "items": { "type": "integer", "minimum": 0 },
                "minItems": 2,
                "maxItems": 2
              }
            }
          }
        }
      }
    }
  }
}
